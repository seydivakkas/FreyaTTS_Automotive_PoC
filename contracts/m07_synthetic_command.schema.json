{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freya-automotive:m07_synthetic_command:v1",
  "title": "M07 Synthetic Command - no raw text or audio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "kind",
    "session_id",
    "turn_id",
    "generation_id",
    "sequence",
    "payload_ref",
    "deadline_mono_ns",
    "idempotent"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "stt",
        "tts",
        "llm",
        "telephony"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "turn_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "generation_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "payload_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
    },
    "deadline_mono_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "idempotent": {
      "type": "boolean"
    }
  }
}
